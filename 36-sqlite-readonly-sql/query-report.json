    {
      "name": "price_bands",
      "question": "有效订单主要落在哪些价格区间？",
      "sql": "SELECT\n    CASE\n        WHEN total_price < 500 THEN '0-499'\n        WHEN total_price < 1000 THEN '500-999'\n        WHEN total_price < 2000 THEN '1000-1999'\n        ELSE '2000+'\n    END AS price_band,\n    COUNT(*) AS orders\nFROM bookings\nWHERE canceled = 'no'\n  AND nights > 0\n  AND guests > 0\n  AND total_price > 0\nGROUP BY price_band\nORDER BY MIN(total_price)",
