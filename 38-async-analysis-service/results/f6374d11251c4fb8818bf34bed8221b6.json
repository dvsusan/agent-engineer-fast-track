  "city_summary": {
    "name": "city_summary",
    "question": "哪些城市的有效订单最多？平均订单价格是多少？",
    "sql": "SELECT\n    COALESCE(NULLIF(city, ''), '<缺失>') AS city,\n    COUNT(*) AS valid_orders,\n    ROUND(AVG(total_price), 2) AS avg_price\nFROM bookings\nWHERE canceled = 'no'\n  AND nights > 0\n  AND guests > 0\n  AND total_price > 0\nGROUP BY COALESCE(NULLIF(city, ''), '<缺失>')\nORDER BY valid_orders DESC, city ASC",
