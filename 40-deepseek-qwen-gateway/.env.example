# 主模型：DeepSeek 使用 OpenAI 兼容接口，不需要安装 OpenAI SDK。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
# 代码会发送 thinking.type=disabled，避免推理内容先耗尽 max_tokens。

# 备用模型：阿里云百炼提供的通义千问 OpenAI 兼容接口。
# 官方文档也使用 DASHSCOPE_API_KEY；程序会同时识别两个变量名。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SECONDS=20
# 代码会发送 enable_thinking=false，避免推理阶段拖长首轮响应时间。

# 如果控制台已经展示了业务空间专属域名，可替换为下面的形式：
# QWEN_BASE_URL=https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
